							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"analytics",
								"page-views"
							],
							"query": [
								{
									"key": "start_date",
									"value": "{{start_date}}",
									"description": "Start date in ISO format"
								},
								{
									"key": "end_date",
									"value": "{{end_date}}",
									"description": "End date in ISO format"
								}
							]
						},
						"description": "Get analytics data for page views"
					},
					"response": []
				},
